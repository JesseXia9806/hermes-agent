## 🚀 快速强化脚本

以下是一个实用的安全强化检查清单脚本（参考 `references/hardening-checklist.sh`）。

```bash
#!/bin/bash
# Linux 安全强化检查脚本
# 使用方法: bash hardening-checklist.sh dry-run

LOG_FILE="/var/log/hardening_$(date +%Y%m%d_%H%M%S).log"

echo "=== Linux 安全强化检查 ===" | tee "$LOG_FILE"

echo "1. 检查系统更新状态..." | tee -a "$LOG_FILE"
if command -v apt >/dev/null 2>&1; then
    apt list --upgradable 2>/dev/null | wc -l | xargs echo "待更新包: " | tee -a "$LOG_FILE"
elif command -v dnf >/dev/null 2>&1; then
    dnf check-update 2>/dev/null | wc -l | xargs echo "待更新包: " | tee -a "$LOG_FILE"
fi

echo "2. 检查 SSH 配置..." | tee -a "$LOG_FILE"
if [ -f /etc/ssh/sshd_config ]; then
    grep -E "(PasswordAuthentication|PermitRootLogin|PubkeyAuthentication)" /etc/ssh/sshd_config
fi

echo "3. 检查网络服务..." | tee -a "$LOG_FILE"
ss -tlnp 2>/dev/null | grep -E "(:22|:80|:3001|:443)" || netstat -tlnp 2>/dev/null | grep -E "(:22|:80|:3001|:443)" || echo "无明文端口暴露" | tee -a "$LOG_FILE"

echo "4. 检查 sudo 配置..." | tee -a "$LOG_FILE"
if [ -d /etc/sudoers.d ]; then
    find /etc/sudoers.d -type f -name "*" -exec echo "=== {} ===" \; -exec cat {} \; 2>/dev/null
fi

echo "=== 检查完成 ===" | tee -a "$LOG_FILE"
if [[ "$1" == "dry-run" ]]; then
    echo "[DRY-RUN] 实际操作需手动执行" | tee -a "$LOG_FILE"
fi
```

完整脚本请参考 `scripts/hardening-checklist.sh`。

