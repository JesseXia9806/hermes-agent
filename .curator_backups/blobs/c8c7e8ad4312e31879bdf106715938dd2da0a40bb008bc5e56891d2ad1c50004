## 🔄 持续监控

**监控脚本 (参考 `scripts/monitoring.sh`):**

```bash
#!/bin/bash
# 持续安全监控

# 1. 检查系统更新
check_updates() {
    if command -v apt >/dev/null 2>&1; then
        apt list --upgradable 2>/dev/null | grep -c "upgradable"
    fi
}

# 2. 检查网络暴露
check_ports() {
    ss -tlnp 2>/dev/null | grep -E "(:22|:80|:3001)" | wc -l
}

# 3. 检查 SSH 配置
check_ssh_config() {
    if [ -f /etc/ssh/sshd_config ]; then
        if grep -q "PasswordAuthentication yes" /etc/ssh/sshd_config; then
            return 1
        fi
    fi
    return 0
}

# 4. 检查日志
check_logs() {
    tail -n 100 /var/log/auth.log 2>/dev/null | grep -E "Failed password|Invalid user"
}

# 5. 检查 cron 任务
check_cron() {
    crontab -l 2>/dev/null
}

# 执行所有检查
{
    echo "=== $(date) ==="
    echo "待更新包: $(check_updates)"
    echo "开放端口: $(check_ports)"
    echo "SSH 安全状态: $(check_ssh_config && echo '安全' || echo '不安全')"
    echo "可疑登录尝试: $(check_logs | wc -l)"
} > /var/log/security_monitor.log
```

完整监控脚本请参考 `scripts/monitoring.sh`。

